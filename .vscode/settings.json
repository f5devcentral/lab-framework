{
    "editor.tabSize": 2,
    "eslint.enable": true,
    "eslint.validate": [
        "javascript",
        "html",
        "typescriptreact",
        "javascriptreact"
    ],
    "cSpell.words": [
        "devcontainer",
        "dockerode",
        "nginx",
        "petname",
        "solarizedlight"
    ],
    // Specify paths/files to ignore.
    "cSpell.ignorePaths": [
        "devcontainer.json",
        "settings.json",
        "jsonconfig.json"
    ],
    "js/ts.validate.enabled": true,
    "eslint.useFlatConfig": true,
    "jest.runMode": "on-demand",
    "chat.tools.terminal.autoApprove": {
        "npx jest": true
    },
}
